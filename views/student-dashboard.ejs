  <!-- Header Navigation -->
  <header class="sticky top-0 z-50 glass-nav px-6 py-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400">
          <i data-lucide="shield" class="w-5 h-5"></i>
        </div>
        <div>
          <span class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold block">Synthetic Nature</span>
          <h1 class="text-lg font-bold text-white tracking-tight">
            <%= (typeof user !== 'undefined' && user.name) ? user.name : 'Student Portal' %>
          </h1>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <% if (typeof user !== 'undefined' && (user.roomNumber || user.roomNo)) { %>
          <div class="hidden sm:flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-slate-300">
            <i data-lucide="door-closed" class="w-3.5 h-3.5 text-blue-400"></i>
            <span>Room <strong class="text-white"><%= user.roomNumber || user.roomNo %></strong></span>
          </div>
        <% } %>
        <a href="/logout" class="secondary-btn px-4 py-2 rounded-xl text-xs font-medium text-slate-200 flex items-center gap-2">
          <i data-lucide="log-out" class="w-3.5 h-3.5 text-slate-400"></i>
          <span>Sign Out</span>
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-6 pt-8 space-y-8">
    
    <!-- Hero / Top Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
          Resident HQ
        </h2>
        <p class="text-sm text-slate-400 mt-0.5">
          Manage tickets, gate passes, and view live attendance status
        </p>
      </div>

      <!-- Faculty Directory Link -->
      <a href="/student/faculty-directory" class="secondary-btn px-5 py-2.5 rounded-xl text-xs font-semibold text-white flex items-center justify-center gap-2 self-start md:self-auto shadow-sm">
        <i data-lucide="search" class="w-4 h-4 text-blue-400"></i>
        <span>Find Faculty Cabins & Free Slots</span>
      </a>
    </div>

    <!-- Real-Time Live Attendance Section -->
    <section class="glass-card rounded-2xl p-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5 border-b border-white/10 pb-4">
        <div class="flex items-center gap-2.5">
          <div class="p-2 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
            <i data-lucide="scan-face" class="w-5 h-5"></i>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Live Biometric Attendance (CS301)</h3>
            <p class="text-xs text-slate-400">Synchronized real-time class verification status</p>
          </div>
        </div>
        <div class="self-start sm:self-auto px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-slate-300">
          Overall Attendance: <strong class="text-white font-bold"><%= typeof overallPercentage !== 'undefined' ? overallPercentage : '100' %>%</strong>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 rounded-xl glass-row flex items-center justify-between">
          <div class="space-y-1">
            <span class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold block">Today's Status</span>
            <span class="text-base font-bold text-white block" id="attendanceStatusText">
              <%= (typeof todayAttendance !== 'undefined' && todayAttendance) ? 'Marked Present' : 'Not Marked Today' %>
            </span>
          </div>
          <div id="statusBadgeContainer">
            <% if (typeof todayAttendance !== 'undefined' && todayAttendance) { %>
              <span class="px-3 py-1 rounded-full text-[11px] font-semibold tracking-wider border border-emerald-500/30 bg-emerald-500/10 text-emerald-400">
                PRESENT
              </span>
            <% } else { %>
              <span class="px-3 py-1 rounded-full text-[11px] font-semibold tracking-wider border border-amber-500/30 bg-amber-500/10 text-amber-400">
                PENDING
              </span>
            <% } %>
          </div>
        </div>

        <div class="p-4 rounded-xl glass-row flex items-center justify-between">
          <div class="space-y-1">
            <span class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold block">Verification Method</span>
            <span class="text-base font-bold text-white block" id="verificationMethodText">
              <%= (typeof todayAttendance !== 'undefined' && todayAttendance) ? todayAttendance.verificationMethod : 'Kiosk Scanner' %>
            </span>
          </div>
          <span class="text-xs font-medium text-slate-400" id="markedTimeText">
            <%= (typeof todayAttendance !== 'undefined' && todayAttendance) ? new Date(todayAttendance.markedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : 'Awaiting Scan' %>
          </span>
        </div>
      </div>
    </section>

    <!-- Announcements -->
    <section class="glass-card rounded-2xl p-6">
      <div class="flex items-center gap-2 mb-4 border-b border-white/10 pb-3">
        <i data-lucide="bell" class="w-4 h-4 text-blue-400"></i>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white">Campus Announcements</h3>
      </div>
      
      <div class="space-y-3">
        <% if (typeof announcements !== 'undefined' && announcements && announcements.length > 0) { %>
          <% announcements.forEach(notice => { %>
            <div class="p-4 rounded-xl glass-row space-y-2">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h4 class="font-semibold text-white text-sm"><%= notice.title || 'Notice' %></h4>
                <span class="text-[11px] font-medium text-slate-400">
                  <%= notice.postedBy ? notice.postedBy.name : 'Warden' %> &bull; <%= notice.createdAt ? new Date(notice.createdAt).toLocaleDateString() : 'Recent' %>
                </span>
              </div>
              <p class="text-xs text-slate-300 leading-relaxed font-normal"><%= notice.content || notice.message %></p>
            </div>
          <% }) %>
        <% } else { %>
          <div class="text-center py-6 text-xs text-slate-400 font-medium">No announcements recorded.</div>
        <% } %>
      </div>
    </section>

    <!-- Maintenance & Visitor Forms -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- Log Ticket -->
      <div class="glass-card rounded-2xl p-6">
        <div class="flex items-center gap-2.5 mb-5 border-b border-white/10 pb-3">
          <i data-lucide="wrench" class="w-4 h-4 text-blue-400"></i>
          <h3 class="text-base font-bold text-white">Log Maintenance Ticket</h3>
        </div>
        <form action="/student/issues" method="POST" class="space-y-4">
          <div class="space-y-1.5">
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300">Issue Category</label>
            <select name="category" required class="form-input w-full rounded-xl px-4 py-3 text-xs font-medium cursor-pointer">
              <option value="Plumbing" class="bg-slate-900 text-white">Plumbing</option>
              <option value="Electrical" class="bg-slate-900 text-white">Electrical</option>
              <option value="Carpentry" class="bg-slate-900 text-white">Carpentry</option>
              <option value="Cleaning" class="bg-slate-900 text-white">Cleaning</option>
              <option value="Other" class="bg-slate-900 text-white">Other</option>
            </select>
          </div>
          <div class="space-y-1.5">
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300">Description</label>
            <textarea name="description" rows="3" placeholder="Describe the issue in detail..." required class="form-input w-full rounded-xl p-3.5 text-xs placeholder:text-slate-500 resize-none font-normal"></textarea>
          </div>
          <button type="submit" class="primary-btn w-full py-3 rounded-xl text-white font-medium text-xs flex items-center justify-center gap-2 shadow-md">
            <i data-lucide="send" class="w-3.5 h-3.5"></i>
            <span>Submit Request</span>
          </button>
        </form>
      </div>

      <!-- Pre-Register Visitor -->
      <div class="glass-card rounded-2xl p-6">
        <div class="flex items-center gap-2.5 mb-5 border-b border-white/10 pb-3">
          <i data-lucide="ticket" class="w-4 h-4 text-blue-400"></i>
          <h3 class="text-base font-bold text-white">Pre-Register Visitor</h3>
        </div>
        <form action="/student/visitors" method="POST" class="space-y-4">
          <div class="space-y-1.5">
            <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300">Visitor Name</label>
            <input type="text" name="visitorName" placeholder="Full Name" required class="form-input w-full rounded-xl px-4 py-3 text-xs placeholder:text-slate-500 font-normal" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300">Visitor Phone</label>
              <input type="text" name="visitorPhone" placeholder="Phone Number" required class="form-input w-full rounded-xl px-4 py-3 text-xs placeholder:text-slate-500 font-normal" />
            </div>
            <div class="space-y-1.5">
              <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300">Visit Date</label>
              <input type="date" name="visitDate" required class="form-input w-full rounded-xl px-4 py-3 text-xs font-normal" />
            </div>
          </div>
          <button type="submit" class="primary-btn w-full py-3 rounded-xl text-white font-medium text-xs flex items-center justify-center gap-2 shadow-md">
            <i data-lucide="key" class="w-3.5 h-3.5"></i>
            <span>Generate Gate Pass</span>
          </button>
        </form>
      </div>

    </div>

    <!-- Active Tables -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- Maintenance Tickets List -->
      <div class="glass-card rounded-2xl p-6">
        <div class="flex items-center gap-2 mb-4 border-b border-white/10 pb-3">
          <i data-lucide="clock" class="w-4 h-4 text-blue-400"></i>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-white">Active Maintenance Tickets</h3>
        </div>
        <div class="space-y-3">
          <% if (typeof issues !== 'undefined' && issues && issues.length > 0) { %>
            <% issues.forEach(issue => { %>
              <%
                const createdTime = new Date(issue.createdAt);
                const endTime = issue.status === 'Resolved' ? new Date(issue.updatedAt) : new Date();
                const diffMins = Math.floor((endTime - createdTime) / (1000 * 60));
                const hrs = Math.floor(diffMins / 60);
                const mins = diffMins % 60;
                let timeText;
                if (hrs >= 24) {
                  const days = Math.floor(hrs / 24);
                  const remainingHrs = hrs % 24;
                  timeText = remainingHrs > 0 ? `${days}d ${remainingHrs}h` : `${days}d`;
                } else if (hrs > 0) {
                  timeText = `${hrs}h ${mins}m`;
                } else {
                  timeText = `${mins}m`;
                }
              %>
              <div class="p-3.5 rounded-xl glass-row flex items-center justify-between gap-3 text-xs">
                <div class="space-y-1">
                  <span class="font-bold text-white block"><%= issue.category %></span>
                  <p class="text-slate-300 font-normal text-[11px] line-clamp-1"><%= issue.description %></p>
                </div>
                <div class="flex flex-col items-end gap-1.5 shrink-0">
                  <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold uppercase border border-white/10 bg-white/5 text-slate-300">
                    <%= issue.status %>
                  </span>
                  <span class="text-[10px] text-slate-400 font-medium">
                    <% if (issue.urgency === 'High') { %>
                      🚨 High Priority
                    <% } else if (issue.urgency === 'Medium') { %>
                      ⚠️ Medium
                    <% } else { %>
                      Low
                    <% } %>
                    &bull; <%= timeText %>
                  </span>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-center py-6 text-xs text-slate-400 font-medium">No tickets logged.</div>
          <% } %>
        </div>
      </div>

      <!-- Gate Passes List -->
      <div class="glass-card rounded-2xl p-6">
        <div class="flex items-center gap-2 mb-4 border-b border-white/10 pb-3">
          <i data-lucide="shield-check" class="w-4 h-4 text-blue-400"></i>
          <h3 class="text-sm font-semibold uppercase tracking-wider text-white">Gate Passes Issued</h3>
        </div>
        <div class="space-y-3">
          <% if (typeof visitors !== 'undefined' && visitors && visitors.length > 0) { %>
            <% visitors.forEach(pass => { %>
              <div class="p-3.5 rounded-xl glass-row flex items-center justify-between gap-3 text-xs">
                <div class="space-y-1">
                  <span class="font-bold text-white block"><%= pass.visitorName %></span>
                  <div class="flex items-center gap-2">
                    <code class="text-[10px] font-mono tracking-wider bg-black/40 px-2 py-0.5 rounded text-blue-300"><%= pass.passcode %></code>
                    <span class="text-[10px] text-slate-400">Date: <%= pass.visitDate ? new Date(pass.visitDate).toLocaleDateString() : 'N/A' %></span>
                  </div>
                </div>

                <div class="flex items-center gap-3">
                  <% if (pass.qrCode) { %>
                    <img src="<%= pass.qrCode %>" alt="Gate Pass QR Code" class="w-12 h-12 bg-white p-1 rounded-lg shrink-0">
                  <% } %>
                  
                  <% if (pass.status === 'APPROVED' || pass.status === 'Approved') { %>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold border border-emerald-500/30 bg-emerald-500/10 text-emerald-400">APPROVED</span>
                  <% } else if (pass.status === 'CheckedIn') { %>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold border border-blue-500/30 bg-blue-500/10 text-blue-400">CHECKED IN</span>
                  <% } else if (pass.status === 'EXPIRED') { %>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold border border-slate-500/30 bg-slate-500/10 text-slate-400">EXPIRED</span>
                  <% } else { %>
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-semibold border border-amber-500/30 bg-amber-500/10 text-amber-400">PENDING</span>
                  <% } %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-center py-6 text-xs text-slate-400 font-medium">No active passes found.</div>
          <% } %>
        </div>
      </div>

    </div>

  </main>

  <script>
    lucide.createIcons();

    // Socket.IO Listener for Live Student Attendance Update
    const socket = io();
    socket.on('attendance_updated', (data) => {
      if (window.currentUserId && String(window.currentUserId) === String(data.studentId)) {
        const badgeContainer = document.getElementById('statusBadgeContainer');
        const statusText = document.getElementById('attendanceStatusText');
        const methodText = document.getElementById('verificationMethodText');
        const timeText = document.getElementById('markedTimeText');

        if (badgeContainer) {
          badgeContainer.innerHTML = `
            <span class="px-3 py-1 rounded-full text-[11px] font-semibold tracking-wider border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 animate-pulse">
              PRESENT
            </span>
          `;
        }
        if (statusText) statusText.innerText = 'Marked Present';
        if (methodText) methodText.innerText = data.verificationMethod || 'FACE_RECOGNITION';
        if (timeText) timeText.innerText = new Date(data.markedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      }
    });
  </script>
</body>
</html>