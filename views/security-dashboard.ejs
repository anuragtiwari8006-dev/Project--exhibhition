
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Synthetic Nature — Security Checkpoint Portal</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Modern Clean Font Stack -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- QR SCANNER LIBRARY -->
  <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

  <style>
    body {
      background-color: #030712;
      color: #f9fafb;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .glass-nav {
      background: rgba(15, 23, 42, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .glass-card {
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    }

    .glass-row {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
      transition: all 0.2s ease;
    }

    .glass-row:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.12);
    }

    .form-input {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #ffffff;
      transition: all 0.2s ease;
    }
    
    .form-input:focus {
      background: rgba(255, 255, 255, 0.08);
      border-color: #10b981;
      outline: none;
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
    }

    .approve-btn {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      transition: all 0.2s ease;
    }

    .approve-btn:hover {
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
      box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
    }

    .secondary-btn {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.12);
      transition: all 0.2s ease;
    }

    .secondary-btn:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.25);
    }

    /* Custom HTML5 QR Code Scanner Styling */
    #reader {
      border: 1px solid rgba(255, 255, 255, 0.1) !important;
      border-radius: 1rem !important;
      overflow: hidden;
      background: rgba(0, 0, 0, 0.4) !important;
    }
    
    #reader video {
      object-fit: cover !important;
      border-radius: 0.75rem !important;
    }

    #reader__dashboard {
      background: transparent !important;
      color: #94a3b8 !important;
      padding: 8px !important;
    }

    #reader__dashboard button {
      background: rgba(255, 255, 255, 0.08) !important;
      border: 1px solid rgba(255, 255, 255, 0.2) !important;
      color: #ffffff !important;
      padding: 6px 16px !important;
      border-radius: 0.5rem !important;
      font-size: 12px !important;
      font-weight: 600 !important;
      cursor: pointer !important;
    }

    /* Custom Scrollbar for Horizontal Tables */
    .custom-scrollbar::-webkit-scrollbar {
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.02);
      border-radius: 8px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.15);
      border-radius: 8px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.3);
    }
  </style>
</head>
<body class="min-h-full pb-16 relative overflow-x-hidden selection:bg-emerald-500 selection:text-white">

  <!-- Background Video -->
  <video autoPlay muted loop playsInline class="fixed inset-0 w-full h-full object-cover object-center -z-20 pointer-events-none">
    <source src="https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260619_191346_9d19d66e-86a4-47f7-8dc6-712c1788c3b2.mp4" type="video/mp4">
  </video>

  <!-- Dark Ambient Overlay -->
  <div class="fixed inset-0 bg-slate-950/75 backdrop-brightness-90 pointer-events-none -z-10"></div>

  <!-- Header Navigation -->
  <header class="sticky top-0 z-50 glass-nav px-6 py-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="p-2 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
          <i data-lucide="shield-check" class="w-5 h-5"></i>
        </div>
        <div>
          <span class="text-[10px] uppercase tracking-widest text-slate-400 font-semibold block">Synthetic Nature</span>
          <h1 class="text-lg font-bold text-white tracking-tight">
            Security Checkpoint Portal
          </h1>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <div class="hidden sm:flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-slate-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Checkpoint Active</span>
        </div>
        <a href="/logout" class="secondary-btn px-4 py-2 rounded-xl text-xs font-medium text-slate-200 flex items-center gap-2">
          <i data-lucide="log-out" class="w-3.5 h-3.5 text-slate-400"></i>
          <span>Logout</span>
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-6 pt-8 space-y-8">
    
    <!-- Hero Title -->
    <div>
      <h2 class="text-2xl md:text-3xl font-bold text-white tracking-tight">
        Gate Entry Verification
      </h2>
      <p class="text-sm text-slate-400 mt-0.5">
        Scan visitor QR codes or enter 6-digit passcodes to grant campus entry
      </p>
    </div>

    <!-- MAIN VERIFICATION CARD -->
    <section class="glass-card rounded-2xl p-6 md:p-8 space-y-6">
      
      <!-- ERROR MESSAGE -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-4 rounded-xl border border-red-500/30 bg-red-500/10 text-red-400 text-xs font-medium flex items-center gap-2.5">
          <i data-lucide="alert-circle" class="w-4 h-4 shrink-0"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <!-- SUCCESS MESSAGE -->
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="p-4 rounded-xl border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 text-xs font-medium flex items-center gap-2.5">
          <i data-lucide="check-circle-2" class="w-4 h-4 shrink-0"></i>
          <span><%= success %></span>
        </div>
      <% } %>

      <!-- QR SCANNER SECTION -->
      <div class="text-center max-w-lg mx-auto space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold">
          <i data-lucide="qr-code" class="w-3.5 h-3.5"></i>
          <span>Scan Gate Pass QR Code</span>
        </div>
        
        <p class="text-xs text-slate-400">
          Scan the visitor's QR code to automatically verify and log entry.
        </p>

        <!-- CAMERA VIEWPORT -->
        <div id="reader" class="w-full max-w-[380px] mx-auto my-4 shadow-2xl"></div>

        <!-- SCAN STATUS MESSAGE -->
        <div id="scanMessage" class="text-xs font-medium text-slate-300 flex items-center justify-center gap-2">
          <i data-lucide="camera" class="w-3.5 h-3.5 text-blue-400"></i>
          <span>Allow camera access to start scanning.</span>
        </div>

        <p class="text-[11px] text-slate-500">
          Position the QR code inside the scanning frame.
        </p>
      </div>

      <!-- DIVIDER -->
      <div class="relative flex py-2 items-center">
        <div class="flex-grow border-t border-white/10"></div>
        <span class="flex-shrink mx-4 text-[11px] font-bold text-slate-500 uppercase tracking-widest">OR</span>
        <div class="flex-grow border-t border-white/10"></div>
      </div>

      <!-- MANUAL PASSCODE SECTION -->
      <div class="text-center max-w-md mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-slate-300 text-xs font-semibold">
          <i data-lucide="key-round" class="w-3.5 h-3.5 text-amber-400"></i>
          <span>Enter Passcode Manually</span>
        </div>

        <form id="verifyForm" action="/security/verify-passcode" method="POST" class="space-y-4">
          <div class="space-y-1.5 text-left">
            <label for="passcode" class="block text-xs font-semibold uppercase tracking-wider text-slate-300 text-center">
              Visitor Passcode
            </label>
            
            <input
              type="text"
              id="passcode"
              name="passcode"
              placeholder="6-digit code"
              maxlength="6"
              minlength="6"
              pattern="[0-9]{6}"
              required
              autocomplete="off"
              class="form-input w-full rounded-xl px-4 py-3 text-center text-lg font-mono tracking-widest font-bold placeholder:text-slate-600 placeholder:font-normal placeholder:tracking-normal"
            />
          </div>

          <button type="submit" class="approve-btn w-full py-3 rounded-xl text-white font-medium text-xs flex items-center justify-center gap-2 shadow-md">
            <i data-lucide="user-check" class="w-4 h-4"></i>
            <span>Verify & Check-In</span>
          </button>
        </form>
      </div>

    </section>

    <!-- RECENT VISITOR CHECK-INS -->
    <section class="glass-card rounded-2xl p-6">
      <div class="flex items-center gap-2.5 mb-5 border-b border-white/10 pb-3">
        <i data-lucide="list-checks" class="w-4 h-4 text-emerald-400"></i>
        <h3 class="text-base font-bold text-white">Recent Visitor Check-Ins</h3>
      </div>

      <div class="overflow-x-auto custom-scrollbar">
        <table class="w-full text-left text-xs border-separate border-spacing-y-2">
          <thead>
            <tr class="text-[11px] uppercase tracking-wider text-slate-400 font-semibold">
              <th class="pb-2 px-3">Visitor Name</th>
              <th class="pb-2 px-3">Student / Resident</th>
              <th class="pb-2 px-3">Room No</th>
              <th class="pb-2 px-3">Check-In Time</th>
              <th class="pb-2 px-3 text-right">Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (typeof recentLogs !== 'undefined' && recentLogs.length > 0) { %>
              <% recentLogs.forEach(log => { %>
                <tr class="glass-row rounded-xl">
                  <td class="py-3 px-3 rounded-l-xl font-bold text-white">
                    <%= log.visitorName %>
                  </td>
                  <td class="py-3 px-3 text-slate-200">
                    <%= log.resident ? log.resident.name : 'N/A' %>
                  </td>
                  <td class="py-3 px-3 font-semibold text-slate-300">
                    <%= log.resident ? log.resident.roomNumber : 'N/A' %>
                  </td>
                  <td class="py-3 px-3 text-slate-400 font-medium">
                    <%= new Date(log.checkInTime || log.updatedAt).toLocaleString() %>
                  </td>
                  <td class="py-3 px-3 text-right rounded-r-xl">
                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold border border-emerald-500/30 bg-emerald-500/10 text-emerald-400 uppercase tracking-wider">
                      <%= log.status %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" class="text-center py-6 text-xs text-slate-400 font-medium">
                  No visitor entries logged yet today.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

  </main>

  <!-- QR SCANNER JAVASCRIPT -->
  <script>
    const scanner = new Html5Qrcode("reader");
    let scanning = true;

    /*
     * WHEN QR CODE IS SUCCESSFULLY SCANNED
     */
    function onScanSuccess(decodedText, decodedResult) {
      if (!scanning) {
        return;
      }
      scanning = false;

      console.log("QR Code detected:", decodedText);

      const message = document.getElementById("scanMessage");
      message.innerText = "✅ QR detected. Verifying gate pass...";

      /*
       * DEFAULT: Assume QR contains only the passcode.
       */
      let passcode = decodedText.trim();

      /*
       * IF QR CONTAINS JSON
       */
      try {
        const qrData = JSON.parse(decodedText);
        if (qrData.passcode) {
          passcode = String(qrData.passcode).trim();
        }
      } catch (error) {
        /* QR is plain text. Nothing to do. */
      }

      /*
       * PUT PASSCODE INTO INPUT
       */
      document.getElementById("passcode").value = passcode;

      /*
       * STOP CAMERA
       */
      scanner.stop()
        .then(() => {
          console.log("Scanner stopped.");
          document.getElementById("verifyForm").submit();
        })
        .catch(error => {
          console.error("Scanner stop error:", error);
          document.getElementById("verifyForm").submit();
        });
    }

    /*
     * SCAN FAILURE (Ignored continuously)
     */
    function onScanFailure(error) {
      // Ignore normal scanning failures.
    }

    /*
     * GET AVAILABLE CAMERAS
     */
    Html5Qrcode.getCameras()
      .then(cameras => {
        if (cameras && cameras.length > 0) {
          scanner.start(
            cameras[0].id,
            {
              fps: 10,
              qrbox: { width: 220, height: 220 }
            },
            onScanSuccess,
            onScanFailure
          )
          .then(() => {
            document.getElementById("scanMessage").innerText = "📷 Camera active. Scan the QR code.";
          })
          .catch(error => {
            console.error("Camera start error:", error);
            document.getElementById("scanMessage").innerText = "❌ Unable to start camera.";
          });
        } else {
          document.getElementById("scanMessage").innerText = "❌ No camera found on this device.";
        }
      })
      .catch(error => {
        console.error("Camera permission error:", error);
        document.getElementById("scanMessage").innerText = "❌ Camera permission denied or unavailable.";
      });

    lucide.createIcons();
  </script>
</body>
</html>