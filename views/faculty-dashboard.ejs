<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Faculty Control Panel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

  <nav class="navbar navbar-dark bg-dark mb-4 shadow-sm">
    <div class="container">
      <span class="navbar-brand fw-bold">🎓 Faculty Control Panel</span>
      <div class="d-flex align-items-center gap-3">
        <span class="text-white small">Logged in as: <strong><%= profile.user ? profile.user.name : user.name %></strong></span>
        <a href="/logout" class="btn btn-outline-danger btn-sm">Logout</a>
      </div>
    </div>
  </nav>

  <div class="container mb-5">
    
    <div class="mb-4">
      <h3 class="fw-bold">Welcome, <%= profile.user ? profile.user.name : user.name %>!</h3>
      <p class="text-muted">Manage your academic room location, toggle your leave status, and update available free slots.</p>
    </div>

    <div class="row g-4">
      
      <!-- Left Column: Room Info & Leave Status -->
      <div class="col-md-5">
        
        <!-- Room/Cabin Update Form -->
        <div class="card shadow-sm border-0 mb-4">
          <div class="card-header bg-primary text-white">
            <h5 class="mb-0">📍 Room & Department Details</h5>
          </div>
          <div class="card-body">
            <form action="/faculty/update-room" method="POST">
              <div class="mb-3">
                <label class="form-label fw-semibold">Department</label>
                <input 
                  type="text" 
                  name="department" 
                  class="form-control" 
                  placeholder="e.g., Computer Science & Engineering"
                  value="<%= profile.department || '' %>"
                  required
                >
              </div>
              <div class="mb-3">
                <label class="form-label fw-semibold">Academic Room / Cabin No.</label>
                <input 
                  type="text" 
                  name="officeHoursRoom" 
                  class="form-control" 
                  placeholder="e.g., Academic Block A - Room 305"
                  value="<%= profile.officeHoursRoom || '' %>"
                  required
                >
              </div>
              <button type="submit" class="btn btn-primary w-100">Save Details</button>
            </form>
          </div>
        </div>

        <!-- On Leave / Available Toggle Form -->
        <div class="card shadow-sm border-0">
          <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">⚠️ Leave / Availability Toggle</h5>
          </div>
          <div class="card-body">
            <form action="/faculty/update-leave" method="POST">
              <div class="form-check form-switch mb-3">
                <input 
                  class="form-check-input" 
                  type="checkbox" 
                  id="isOnLeave" 
                  name="isOnLeave" 
                  <%= profile.isOnLeave ? 'checked' : '' %>
                >
                <label class="form-check-label fw-bold" for="isOnLeave">Mark Me as On Leave / Unavailable</label>
              </div>
              
              <div class="mb-3">
                <label class="form-label small text-muted">Leave Notice (Optional)</label>
                <textarea 
                  name="leaveNotice" 
                  class="form-control" 
                  rows="2" 
                  placeholder="e.g., Away until 2 PM due to committee meeting."
                ><%= profile.leaveNotice || '' %></textarea>
              </div>
              
              <button type="submit" class="btn btn-warning w-100 fw-semibold">Update Status</button>
            </form>
          </div>
        </div>

      </div>

      <!-- Right Column: Free Slots Edit Panel -->
      <div class="col-md-7">
        <div class="card shadow-sm border-0">
          <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">🕒 Manage Free Slots (Mon - Fri)</h5>
          </div>
          <div class="card-body">

            <!-- Add New Slot Form -->
            <form action="/faculty/add-slot" method="POST" class="row g-2 mb-4 align-items-end bg-light p-3 rounded border">
              <div class="col-md-4">
                <label class="form-label small fw-semibold">Day</label>
                <select name="day" class="form-select" required>
                  <option value="">Select Day</option>
                  <option value="Monday">Monday</option>
                  <option value="Tuesday">Tuesday</option>
                  <option value="Wednesday">Wednesday</option>
                  <option value="Thursday">Thursday</option>
                  <option value="Friday">Friday</option>
                </select>
              </div>
              <div class="col-md-3">
                <label class="form-label small fw-semibold">Start Time</label>
                <input type="text" name="startTime" class="form-control" placeholder="10:00 AM" required>
              </div>
              <div class="col-md-3">
                <label class="form-label small fw-semibold">End Time</label>
                <input type="text" name="endTime" class="form-control" placeholder="11:30 AM" required>
              </div>
              <div class="col-md-2">
                <button type="submit" class="btn btn-success w-100">+ Add</button>
              </div>
            </form>

            <!-- List & Delete Current Slots -->
            <h6 class="fw-bold text-dark mb-3">Your Published Free Slots:</h6>
            <% if (profile.freeSlots && profile.freeSlots.length > 0) { %>
              <div class="list-group">
                <% profile.freeSlots.forEach(slot => { %>
                  <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                      <strong class="text-primary"><%= slot.day %>:</strong> 
                      <span>🕒 <%= slot.startTime %> - <%= slot.endTime %></span>
                    </div>
                    <form action="/faculty/delete-slot" method="POST" class="m-0">
                      <input type="hidden" name="slotId" value="<%= slot._id %>">
                      <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2">&times; Remove</button>
                    </form>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <p class="text-muted small italic">No free slots added yet. Use the form above to add slots for students.</p>
            <% } %>

          </div>
        </div>
      </div>

    </div>
  </div>

</body>
</html>
