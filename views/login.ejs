<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Synthetic Nature — Access Portal</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Fonts: Geist & Garamond -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500&display=swap" rel="stylesheet">
  <link href="https://db.onlinewebfonts.com/c/2bf40ab72ea4897a3fd9b6e48b233a19?family=Garamond" rel="stylesheet" type="text/css"/>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    body {
      color: #ffffff;
      font-family: 'Geist', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .font-garamond {
      font-family: 'Garamond', 'Times New Roman', serif;
    }

    .nature-glass {
      background: rgba(10, 10, 10, 0.55);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }

    .nature-input {
      background: rgba(255, 255, 255, 0.03);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #ffffff;
    }
    
    .nature-input:focus {
      background: rgba(255, 255, 255, 0.07);
      border-color: rgba(255, 255, 255, 0.4);
      outline: none;
      box-shadow: 0 0 15px rgba(255, 255, 255, 0.1);
    }

  .liquid-glass {
  background: transparent;
  border: none;
  box-shadow: none;
}
  </style>
</head>
<body class="min-h-full flex flex-col justify-between relative overflow-x-hidden">

  <!-- Header -->
  <header class="relative z-20 w-full px-6 py-6 text-center">
    <span class="text-white uppercase font-light tracking-[0.3em] text-xs md:text-sm">
      Synthetic Nature
    </span>
  </header>

  <!-- Login Card -->
  <main class="relative z-10 max-w-md w-full mx-auto px-5 my-auto">
    <div class="nature-glass rounded-3xl p-8 md:p-10 text-center space-y-6">
      
      <div>
        <h1 class="font-garamond text-4xl md:text-5xl text-white tracking-tight leading-none mb-2">
          ACCESS REALM
        </h1>
        <p class="text-xs text-white/70 font-light tracking-[0.15em] uppercase">
          Sign in to your campus dashboard
        </p>
      </div>

      <!-- Error Message Banner -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-3 rounded-xl bg-red-950/60 border border-red-500/40 text-red-200 text-xs text-center font-light">
          <%= error %>
        </div>
      <% } %>

      <!-- Authentication Form -->
      <form action="/login" method="POST" class="space-y-5 text-left">
        <div>
          <label class="block text-[11px] uppercase tracking-[0.2em] font-light text-white/80 mb-1.5">
            Email / Registration No
          </label>
          <input 
            type="text" 
            name="email" 
            required 
            placeholder="student@hostel.com" 
            class="nature-input w-full rounded-2xl px-4 py-3.5 text-xs placeholder:text-white/30 font-light"
          >
        </div>

        <div>
          <label class="block text-[11px] uppercase tracking-[0.2em] font-light text-white/80 mb-1.5">
            Password
          </label>
          <input 
            type="password" 
            name="password" 
            required 
            placeholder="••••••••" 
            class="nature-input w-full rounded-2xl px-4 py-3.5 text-xs placeholder:text-white/30 font-light"
          >
        </div>

        <button type="submit" class="liquid-glass w-full py-4 rounded-full text-white uppercase tracking-[0.2em] text-xs font-light mt-6 flex items-center justify-center gap-2">
          <span>Enter Portal</span>
          <i data-lucide="arrow-right" class="w-4 h-4 text-white/70"></i>
        </button>
      </form>

    </div>
  </main>

  <footer class="relative z-10 py-6 text-center text-[10px] uppercase tracking-[0.2em] text-white/40">
    Organic Visions &bull; Synthetic Nature Portal
  </footer>

  <script>lucide.createIcons();</script>
</body>
</html>
