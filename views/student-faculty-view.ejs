<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Faculty Directory & Availability</title>
  
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500&display=swap" rel="stylesheet">
  <link href="https://db.onlinewebfonts.com/c/2bf40ab72ea4897a3fd9b6e48b233a19?family=Garamond" rel="stylesheet" type="text/css"/>
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    body {
      background-color: #010101;
      color: #ffffff;
      font-family: 'Geist', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    .font-garamond { font-family: 'Garamond', 'Times New Roman', serif; }
    .nature-glass {
      background: rgba(10, 10, 10, 0.55);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
    }
    .nature-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(10px);
      transition: all 0.25s ease;
    }
    .nature-card:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.18);
    }
    .liquid-glass {
      background: rgba(255, 255, 255, 0.03);
      backdrop-filter: blur(4px);
      border: none;
      box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.15);
    }
  </style>
</head>
<body class="min-h-full pb-16 relative overflow-x-hidden">

  <!-- Header -->
  <header class="sticky top-0 z-50 nature-glass border-b border-white/10 px-6 py-5">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div>
        <span class="text-[10px] uppercase tracking-[0.3em] text-white/50 block">Faculty Directory</span>
        <h1 class="font-garamond text-2xl text-white tracking-tight">Cabin Locations & Availability</h1>
      </div>
      <a href="/student/dashboard" class="liquid-glass px-5 py-2.5 rounded-full text-[11px] uppercase tracking-[0.2em] font-light text-white/90 flex items-center gap-2">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5 text-white/70"></i>
        <span>Back to Dashboard</span>
      </a>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-6 pt-10 space-y-8">
    
    <div class="text-center py-2">
      <h2 class="font-garamond text-3xl sm:text-5xl text-white tracking-tight">FACULTY MEMBERS</h2>
      <p class="text-xs uppercase tracking-[0.25em] text-white/60 font-light mt-2">Find office rooms and free time slots</p>
    </div>

    <!-- Directory Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% if (typeof facultyList !== 'undefined' && facultyList && facultyList.length > 0) { %>
        <% facultyList.forEach(fac => { %>
          <div class="nature-card rounded-3xl p-6 space-y-4 flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-2 mb-3">
                <h3 class="font-garamond text-xl text-white">
                  <%= (fac.user && fac.user.name) ? fac.user.name : 'Faculty Member' %>
                </h3>
                <% if (fac.isOnLeave) { %>
                  <span class="px-2.5 py-1 rounded-full text-[9px] uppercase tracking-widest bg-red-500/10 text-red-400 border border-red-500/20">On Leave</span>
                <% } else { %>
                  <span class="px-2.5 py-1 rounded-full text-[9px] uppercase tracking-widest bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Available</span>
                <% } %>
              </div>

              <div class="space-y-2 text-xs font-light text-white/70">
                <p class="flex items-center gap-2">
                  <i data-lucide="briefcase" class="w-3.5 h-3.5 text-white/50"></i>
                  <span><strong>Dept:</strong> <%= fac.department || 'Not Specified' %></span>
                </p>
                <p class="flex items-center gap-2">
                  <i data-lucide="map-pin" class="w-3.5 h-3.5 text-white/50"></i>
                  <span><strong>Cabin Room:</strong> <%= fac.officeHoursRoom || 'N/A' %></span>
                </p>
              </div>

              <% if (fac.isOnLeave && fac.leaveNotice) { %>
                <div class="mt-3 p-3 rounded-2xl bg-red-500/5 border border-red-500/10 text-red-300 text-[11px] italic">
                  "<%= fac.leaveNotice %>"
                </div>
              <% } %>
            </div>

            <!-- Free Slots Section -->
            <div class="pt-4 border-t border-white/5 mt-4">
              <span class="text-[10px] uppercase tracking-[0.15em] text-white/50 block mb-2 font-light">Free Slots</span>
              <% if (fac.freeSlots && fac.freeSlots.length > 0) { %>
                <div class="space-y-1.5">
                  <% fac.freeSlots.forEach(slot => { %>
                    <div class="text-[11px] bg-white/5 px-3 py-1.5 rounded-xl flex items-center justify-between text-white/80">
                      <span><%= slot.day %></span>
                      <span class="font-mono text-white/60"><%= slot.startTime %> - <%= slot.endTime %></span>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <p class="text-[11px] text-white/40 italic">No free slots updated.</p>
              <% } %>
            </div>

          </div>
        <% }) %>
      <% } else { %>
        <div class="col-span-full text-center py-12 nature-glass rounded-3xl">
          <p class="text-sm text-white/50 italic">No faculty records found in the directory.</p>
        </div>
      <% } %>
    </div>

  </main>

  <script>lucide.createIcons();</script>
</body>
</html>