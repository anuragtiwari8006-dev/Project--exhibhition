<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hostel Portal - Access Error</title>
  <style>
    body { font-family: Arial, sans-serif; background-color: #f8d7da; color: #721c24; text-align: center; padding: 50px; }
    .error-card { background: white; padding: 30px; border-radius: 8px; border: 1px solid #f5c6cb; display: inline-block; max-width: 500px; }
    a { display: inline-block; margin-top: 15px; background: #721c24; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; }
  </style>
</head>
<body>
  <div class="error-card">
    <h2>⚠️ System Notice</h2>
    <p><%= message %></p>
    <a href="/login">Return to Login</a>
  </div>
</body>
</html>